[Unit]
Description=Current-user agent-proxy AI CLI gateway
Documentation=https://github.com/ChrisTitusTech/agent-proxy
After=network-online.target herdr.service
Wants=network-online.target herdr.service

[Service]
Type=simple
WorkingDirectory=@STATE_DIR@
Environment=NODE_ENV=production
EnvironmentFile=@CONFIG_DIR@/agent-proxy.env
ExecStartPre=/usr/bin/env node @DATA_DIR@/current/packages/server/dist/index.js --check
ExecStart=/usr/bin/env node @DATA_DIR@/current/packages/server/dist/index.js
Restart=on-failure
RestartSec=5s
TimeoutStopSec=45s
KillMode=mixed
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=@CONFIG_DIR@ @DATA_DIR@ @STATE_DIR@

[Install]
WantedBy=default.target
