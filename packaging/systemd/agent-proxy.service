[Unit]
Description=Current-user agent-proxy AI CLI gateway
Documentation=https://github.com/ChrisTitusTech/agent-proxy
After=herdr.service
Wants=herdr.service

[Service]
Type=simple
WorkingDirectory="@STATE_DIR@"
Environment=NODE_ENV=production
Environment=XDG_RUNTIME_DIR=%t
EnvironmentFile="@CONFIG_DIR@/agent-proxy.env"
ExecStartPre=/usr/bin/env node "@DATA_DIR@/current/packages/server/dist/index.js" --check
ExecStart=/usr/bin/env node "@DATA_DIR@/current/packages/server/dist/index.js"
Restart=on-failure
RestartSec=5s
TimeoutStopSec=45s
KillMode=mixed
UMask=0077
RuntimeDirectory=agent-proxy
RuntimeDirectoryMode=0700
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHostname=true
ProtectKernelModules=true
ProtectKernelTunables=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=true
RestrictSUIDSGID=true
CapabilityBoundingSet=
LockPersonality=true
SystemCallArchitectures=native
ReadWritePaths="@CONFIG_DIR@" "@DATA_DIR@" "@STATE_DIR@" "%t/agent-proxy"

[Install]
WantedBy=default.target
